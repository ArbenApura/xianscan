# DEEPSEEK (OPENAI-COMPATIBLE) API
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
# deepseek-v4-* THINKS BY DEFAULT (emits reasoning_content, burns output tokens, stalls the stream and
# can return EMPTY content under a token cap). We disable it. Set to `enabled` to turn thinking back on.
DEEPSEEK_REASONING=disabled
# PROCESS-WIDE CONCURRENCY CAP ON OUTBOUND DEEPSEEK CALLS (SINGLE INSTANCE).
# DEEPSEEK_CONCURRENCY=16

# ML SIDECAR (FASTAPI — DETECT/OCR/INPAINT). START IT WITH: cd ml && uvicorn app.main:app --port 8001
ML_BASE_URL=http://127.0.0.1:8001

# SQLITE DATABASE PATH (RELATIVE TO THE web/ DIRECTORY; :memory: FOR TESTS)
DATABASE_PATH=./data/manua.db

# APP DATA ROOT — UPLOADS / CLEANED / OUTPUT IMAGES (DEFAULT: ./data RELATIVE TO THE PROCESS CWD)
# DATA_ROOT=./data

# UPLOADS: adapter-node's DEFAULT BODY_SIZE_LIMIT IS 512K — RAISE IT ABOVE THE LARGEST UPLOAD LIMIT
# (REQUIRED FOR `npm run start` / `npm run preview`; vite dev HAS NO LIMIT).
BODY_SIZE_LIMIT=64M
